#!/bin/sh
# Lab 9: switch this Ubuntu VM to VPN client A or B.
# Clone the Ubuntu VM in VirtualBox (new MAC addresses), then in the clone:
#   sudo lab-client B
# Sets the hostname (ubuntu-a / ubuntu-b), puts the matching client folder in
# ~/Desktop/VPN, gives the VM a new machine ID and SSH host keys, and restarts.
set -e

case "$1" in
    A|a) client=A ;;
    B|b) client=B ;;
    *) echo "Usage: sudo lab-client A|B" >&2; exit 1 ;;
esac
if [ "$(id -u)" -ne 0 ]; then
    echo "Run it with sudo: sudo lab-client $client" >&2
    exit 1
fi

[ "$client" = A ] && other=B || other=A
host="ubuntu-$(echo "$client" | tr AB ab)"
vpn="{{ course_home }}/Desktop/VPN"

# Hostname
hostnamectl set-hostname "$host"
sed -i "s/^127\.0\.1\.1[[:space:]].*/127.0.1.1\t$host/" /etc/hosts

# VPN client folder
mkdir -p "$vpn"
rm -rf "$vpn/client$other"
rm -rf "$vpn/client$client"
cp -r "/usr/local/share/cyberlab/vpn/client$client" "$vpn/"
chown -R {{ course_user }}:{{ course_user }} "$vpn"
chmod 700 "$vpn" "$vpn/client$client"
chmod 644 "$vpn/client$client"/*.crt "$vpn/client$client"/client.ovpn
chmod 600 "$vpn/client$client"/*.key
echo "$client" > /etc/cyberlab-client

# New identity, so the clone does not collide with the original on the network
rm -f /etc/machine-id /var/lib/dbus/machine-id
systemd-machine-id-setup >/dev/null
rm -f /etc/ssh/ssh_host_*
ssh-keygen -A >/dev/null

echo "This VM is now Ubuntu $client ($host), VPN files in $vpn/client$client."
echo "Restarting in 5 seconds..."
sleep 5
systemctl reboot
