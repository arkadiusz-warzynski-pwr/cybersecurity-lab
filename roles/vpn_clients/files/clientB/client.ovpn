# Lab 9 - OpenVPN client (clientB). Use clientA on Ubuntu A and clientB on Ubuntu B.
# 1) Replace X.X.X.X with the Kali VM's IP address.
# 2) cd ~/Desktop/VPN/clientB && sudo openvpn --config client.ovpn
client
dev tun
proto udp
remote X.X.X.X 1194
nobind
persist-tun

ca   ca.crt
cert clientB.crt
key  clientB.key
tls-crypt-v2 clientB-tc2.key
remote-cert-tls server
verify-x509-name kali-vpn-server name

# Lab 9 task 4.3: change data-ciphers (one cipher) and auth here; for CBC
# ciphers set the same auth in the server's server.conf too
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
auth SHA1
# DES needs the OpenSSL legacy provider
providers legacy default
verb 3
