# syntax=docker/dockerfile:1
# Keep the directive above on LINE 1. Docker silently ignores a parser directive
# that follows any comment, and stage 2 needs the BuildKit frontend for
# RUN --mount=type=cache; ignored, the build breaks on a legacy-builder host.
#
# Lab 12 target: designed vulnerable "production system" (amd64).
# Three findings: A vsftpd 2.3.4 backdoor (CVE-2011-2523), B Log4Shell in the
# salary app (CVE-2021-44228), C writable root cron job (privesc). See
# docs/lab12-redesign.md.
# Privileges: the B->C chain starts UNPRIVILEGED - the salary app runs as
# non-root 'app' and only vector C reaches root. Vector A is a STANDALONE
# exercise and vsftpd runs as ROOT on purpose (its libcap startup path will not
# run non-root), which does not affect the chain. Do not "fix" that back.

# --- Stage 1: compile vsftpd 2.3.4 (the vulnerable/backdoored source) --------
# bookworm (current stable); bullseye is archived and its security suite 404s.
# Backdoor osvdb-73573 / CVE-2011-2523: a USER whose name contains ":)" opens a
# shell on port 6200 (runs as root here; vector A is standalone). Compiled
# from readable source, not a prebuilt image (the old Docker Hub one is gone).
FROM debian:bookworm AS vsftpd
ARG VSFTPD_REPO=https://github.com/nikdubois/vsftpd-2.3.4-infected
ARG VSFTPD_REF=e084c9543947d9509ea74731adca427418604cc2
RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates build-essential libpam0g-dev libcap-dev && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone "$VSFTPD_REPO" . && git checkout "$VSFTPD_REF"
# vsf_findlibs.sh only probes pre-multiarch lib paths, so it finds nothing on
# modern Debian; replace it with the libs vsftpd 2.3.4 actually needs (PAM, cap).
# CFLAGS let the old C through gcc 12: -fcommon for the legacy globals, and the
# implicit-decl of the backdoor's vsf_sysutil_extra() in str.c is downgraded.
RUN printf '#!/bin/sh\necho "-lpam -lcap"\n' > vsf_findlibs.sh && chmod +x vsf_findlibs.sh
RUN make CFLAGS="-O2 -fcommon -Wall -Wno-implicit-function-declaration -Wno-error=implicit-function-declaration -D_FORTIFY_SOURCE=0" \
    && test -x vsftpd

# --- Stage 2: build the salary app (Log4Shell, Log4J 2.14.1) -----------------
FROM maven:3.8.6-openjdk-8 AS app
WORKDIR /build
COPY app/pom.xml .
RUN --mount=type=cache,target=/root/.m2 mvn -B dependency:go-offline
COPY app/src ./src
RUN --mount=type=cache,target=/root/.m2 mvn -B package -DskipTests

# --- Final image -------------------------------------------------------------
FROM eclipse-temurin:8-jre-jammy
# No build-time secret: the task 3.3 credential is generated by entrypoint.sh on
# every container start. A --build-arg would be recorded in `docker history`, and
# since 'stud' is in the docker group on the student VM, it could be read off the
# image without touching the chain. Generating at start also means every
# `lab12-target reset` yields a fresh value, so it cannot be passed around.
# procps is listed explicitly on purpose: ps/pgrep would otherwise come in only
# as a transitive dependency of openssh-server, and tests/verify.sh relies on
# them (one check would silently pass if pgrep were missing).
RUN apt-get update && apt-get install -y --no-install-recommends \
      supervisor cron openssh-server libcap2 libcap2-bin libpam-modules \
      libaudit1 libcap-ng0 curl netcat-openbsd ca-certificates procps && \
    rm -rf /var/lib/apt/lists/*

# Accounts. 'app' is the non-root foothold for the Log4Shell chain and is in
# group 'report' so it can write the cron helper (vector C). 'ftp' is the anon
# FTP account for vsftpd. sshd is installed but not started.
RUN groupadd report && \
    useradd -m -s /bin/bash -G report app && \
    useradd -r -d /srv/ftp -s /usr/sbin/nologin ftp && \
    mkdir -p /var/run/sshd /app/data /app/logs /opt/report /srv/ftp /usr/share/empty

# vsftpd binary + config. vsftpd (vector A, standalone) runs as root.
COPY --from=vsftpd /src/vsftpd /usr/local/sbin/vsftpd
COPY vsftpd/vsftpd.conf /etc/vsftpd.conf

# Salary app (Log4Shell). JNDI lookups left enabled (the vulnerable config).
COPY --from=app /build/target/*.jar /app/app.jar
COPY app/data/ /app/data/
RUN chown -R app:app /app

# Vector C: root cron runs /opt/report/run.sh every minute; the script is
# root-owned but group-writable by 'report' (the perms misconfig).
COPY seed/run.sh /opt/report/run.sh
COPY seed/report-cron /etc/cron.d/report
# The template lives outside /etc/salary and is root-only: entrypoint.sh renders
# it into /etc/salary/db.conf at start. Keeping it out of /etc/salary means the
# student finds the rendered config, not a @@SECRET@@ placeholder beside it.
COPY seed/db.conf.tmpl /usr/local/share/salary/db.conf.tmpl
# run.sh is executable AND group-writable by 'report': cron (root) execs it, the
# foothold account (group report) can overwrite it -> privesc.
RUN chmod 0775 /opt/report/run.sh && chown root:report /opt/report/run.sh && \
    chmod 0644 /etc/cron.d/report && \
    mkdir -p /etc/salary && chmod 0755 /etc/salary && \
    chmod 0600 /usr/local/share/salary/db.conf.tmpl

# sshd host keys so the student can start sshd after escalating (task 3.5);
# sshd itself is NOT started here (not in supervisord).
RUN ssh-keygen -A

COPY supervisord.conf /etc/supervisor/conf.d/lab12.conf
COPY entrypoint.sh /entrypoint.sh
RUN chmod 0755 /entrypoint.sh

EXPOSE 21 9876
ENTRYPOINT ["/entrypoint.sh"]
