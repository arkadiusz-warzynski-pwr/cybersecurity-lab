#!/usr/bin/env bash
# Start / stop / reset the Lab 12 target (the "provided production system").
# The image is prebuilt in the VM; this only runs the container. Plain docker
# (no compose): Kali ships only compose v1, and one container needs no compose.
set -euo pipefail
IMAGE=cyberlab/lab12-target:2026
NAME=lab12-target
NET=cyberlab-lab12
SUBNET=10.12.0.0/24
IP=10.12.0.10

d() { if docker info >/dev/null 2>&1; then docker "$@"; else sudo docker "$@"; fi; }

ensure_net() {
  d network inspect "$NET" >/dev/null 2>&1 || d network create --subnet "$SUBNET" "$NET" >/dev/null
}
start() {
  ensure_net
  if [ -n "$(d ps -q -f name="^${NAME}$")" ]; then echo "already running at $IP"; return; fi
  d rm -f "$NAME" >/dev/null 2>&1 || true
  d run -d --name "$NAME" --hostname prod-app-01 --network "$NET" --ip "$IP" \
    --cap-add NET_BIND_SERVICE --restart unless-stopped "$IMAGE" >/dev/null
  echo "target at $IP (ftp 21, web 9876)"
}

case "${1:-}" in
  start)  start ;;
  stop)   d rm -f "$NAME" >/dev/null 2>&1 || true; echo stopped ;;
  reset)  d rm -f "$NAME" >/dev/null 2>&1 || true; start; echo "reset, fresh at $IP" ;;
  status) d ps -a -f name="^${NAME}$" ;;
  ip)     echo "$IP" ;;
  *)      echo "usage: lab12-target {start|stop|reset|status|ip}"; exit 1 ;;
esac
